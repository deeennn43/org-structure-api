@baseUrl = http://localhost:8080

### create department
POST {{baseUrl}}/departments/
Content-Type: application/json

{
  "name": "Компания"
}

### create child department
POST {{baseUrl}}/departments/
Content-Type: application/json

{
  "name": "IT",
  "parent_id": 1
}

### create employee
POST {{baseUrl}}/departments/2/employees/
Content-Type: application/json

{
  "full_name": "Иван Иванов",
  "position": "Backend Developer",
  "hired_at": "2024-06-01"
}

### get department
GET {{baseUrl}}/departments/1?depth=2&include_employees=true

### patch department
PATCH {{baseUrl}}/departments/2
Content-Type: application/json

{
  "name": "IT Department",
  "parent_id": 1
}

### delete cascade
DELETE {{baseUrl}}/departments/2?mode=cascade

### delete reassign
DELETE {{baseUrl}}/departments/3?mode=reassign&reassign_to_department_id=1

### empty name (400)
POST {{baseUrl}}/departments/
Content-Type: application/json

{
  "name": "   "
}

### unknown department (404)
POST {{baseUrl}}/departments/99999/employees/
Content-Type: application/json

{
  "full_name": "Тест",
  "position": "QA"
}
